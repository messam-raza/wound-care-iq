# Copy to .env.local (git-ignored) and restart `npm run dev`.
# WARNING: NEXT_PUBLIC_* values are compiled into the browser JS, so the key is visible to anyone who can
# load the app. Use this for local development only. In production leave it blank and enter the key in Settings.
NEXT_PUBLIC_GROQ_API_KEY=

# Optional overrides. Defaults are the PRD-locked values (AI-07); changing them needs clinical sign-off.
NEXT_PUBLIC_AI_MODEL=llama-3.3-70b-versatile
NEXT_PUBLIC_AI_PROMPT_VERSION=tvn-review-2026.10
NEXT_PUBLIC_AI_TEMPERATURE=0
NEXT_PUBLIC_AI_SEED=20261022
NEXT_PUBLIC_AI_MAX_TOKENS=1100
NEXT_PUBLIC_AI_MAX_RETRIES=3
NEXT_PUBLIC_AI_TIMEOUT_MS=30000
NEXT_PUBLIC_AI_CONCURRENCY=3
